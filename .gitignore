# Data, model weights, run outputs, and caches
# data: track dataset docs (*.md), ignore actual data subdirs
data/*
!data/.gitkeep
!data/*.md
# models: keep per-method dir structure + docs, ignore weights/caches/zips
models/vlbrandphish/*
models/phishintention/*
models/phishpedia/*
!models/*/.gitkeep
outputs/*
!outputs/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx
*.npz
*.npy
*.pkl
*.pickle
artifact_manifest.json
run_metadata*.json

