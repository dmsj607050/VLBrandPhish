# Python and virtual environments
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local configuration and credentials
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials*.json
secrets*.json

# Data, model weights, training code, run outputs, and caches
# Keep the directory skeleton in Git while excluding datasets and model files.
/data/*
!/data/.gitkeep
/models/*
!/models/.gitkeep
# Training code stays local and is not part of the public release.
/training/
outputs/
*.pt
*.pth
*.ckpt
*.onnx
*.npz
*.npy
*.pkl
*.pickle
artifact_manifest.json
run_metadata*.json

# Tooling and platform files
.DS_Store
Thumbs.db
.idea/
.vscode/
wandb/
mlruns/

# Machine-specific one-click runner configuration
inference/vlbrandphish/run_e2e.local.bat

# Local experiment artifacts (manifests, predictions, logs, and caches)
experiments/**/results/*
!experiments/**/results/.gitkeep
# Background launcher logs for local experiment runs
experiments/**/*_launcher.stdout.log
experiments/**/*_launcher.stderr.log
